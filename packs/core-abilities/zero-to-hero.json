        "cost": {
          "activation": "free",
          "trigger": "<p>The user switches-out.</p>"
        },
        "range": {
          "target": "self",
          "unit": "m",
          "distance": 10
        },
        "description": "<p>Trigger: The user switches out, or is Hidden while in Combat.</p><p>Effect: The user transforms into their Hero Forme until the end of combat or when the user gains @Affliction[fainted].</p>",
        "img": "icons/magic/control/silhouette-grow-shrink-blue.webp"
      },
      {
        "traits": [
          "forme-change",
          "flinch-80"
        ],
        "name": "Zero to Hero (Henshin)",
        "slug": "zero-to-hero-henshin",
        "type": "generic",
        "cost": {
          "activation": "complex",
          "powerPoints": 3
        },
        "range": {
          "target": "self",
          "unit": "m"
        },
        "description": "<p>Effect: The user enters their Hero Forme.</p>",
        "img": "icons/magic/control/silhouette-grow-shrink-blue.webp"
      }
    ],
    "description": "<p>Effect: Connection - @UUID[Compendium.ptr2e.core-moves.Item.mQ7A5gRxvfUfZ8ew]. If the user switches out or becomes Hidden during combat (including if they start Combat while Hidden), the user transforms into their Hero Forme until the end of combat or when the user gains @Affliction[fainted]. The user can instead spend 3 PP as a @Trait[flinch-80] Complex Action to transform into their Hero Forme.</p><p>Passive: The user gains @UUID[Compendium.ptr2e.core-abilities.Item.OaDKuFZu1MXY7sQV] and @UUID[Compendium.ptr2e.core-abilities.Item.Iyq0hYJwLpuCncDP] as Connected Abilities. While the user is in their Hero Forme, they instead gain @UUID[Compendium.ptr2e.core-moves.Item.lyjLX6WIIrbdvqXS] as a Connected Move and instead gain @UUID[Compendium.ptr2e.core-abilities.Item.urMg5doRiuVtnIsi] and @UUID[Compendium.ptr2e.core-abilities.Item.Dh63Xai1qofF7Zo8] as Connected Abilities.</p>",
    "traits": [
      "forme-change",
      "innate",
      "connection"
    ],
